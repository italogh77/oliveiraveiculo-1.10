// Regras do Storage (fotos e vídeos) — Oliveira Veículos
// Onde colar: Firebase Console → Storage → Regras → Publicar.
// UID do administrador já preenchido (o mesmo de firestore.rules).
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'wRmeQXxy18cgZudMMXDmAVh0KYI3'
                   && request.resource.size < 60 * 1024 * 1024;
    }
  }
}
